# TalentOne Inside Backend — Umgebungsvariablen
# Diese Datei als .env.local speichern (NICHT ins Git einchecken!)

# Supabase (Recruifly Projekt — gemeinsam genutzt mit talentone-backend)
SUPABASE_URL=https://fhvkbnbjnorsmsvrjizl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Anthropic Claude (für KI-Extraktion aus URLs / PDFs + Motiv-Vorschläge)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (gpt-image-2 für Recruiting-Ad-Generierung)
OPENAI_API_KEY=sk-...

# Resend (für Mail-Versand an Kunden bei "Fotos & Logo anfragen")
RESEND_API_KEY=re_...

# Public Base-URL für Upload-Links in der Mail
PUBLIC_BASE_URL=https://inside.talent-one.de

# Gesellenwerk-Pool (Etappe 3)
# Opt-in-Mails erst erlauben, wenn gesellenwerk.de in Resend verifiziert ist.
GW_MAIL_READY=false
# Absender der Opt-in-Mail. Default nutzt die verifizierte talent-one.de-Domain
# mit Anzeigename "Gesellenwerk"; nach Verifizierung auf gesellenwerk.de umstellen.
GW_MAIL_FROM=Gesellenwerk <noreply@talent-one.de>
# Optionales Reply-To (z. B. kontakt@gesellenwerk.de)
# GW_MAIL_REPLYTO=

# Kling AI (optional, für Reel/Video-Generierung — wenn leer ist Reel-Endpoint deaktiviert)
# KLING_API_KEY=

# Erlaubte Frontend-Origins (CORS), Komma-getrennt
ALLOWED_ORIGINS=https://inside.talent-one.de,http://localhost:5173

# Puppeteer: Chromium-Pfad im Container (Dockerfile setzt das automatisch)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Server Port (optional, default: 3001)
PORT=3001
